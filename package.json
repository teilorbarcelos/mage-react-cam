{
  "name": "mage-react-cam",
  "version": "1.0.17",
  "description": "A React component for capturing camera input",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "release": "npm run bump && npm publish",
    "bump": "npm version patch",
    "prepublishOnly": "if [ \"$(git rev-parse --abbrev-ref HEAD)\" != \"main\" ]; then echo 'Erro: O publish só é permitido na branch main!' && exit 1; fi && npm run build",
    "prepare": "husky"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "camera",
    "optic",
    "zoom",
    "media"
  ],
  "author": "Teilor Souza Barcelos",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "csstype": "^3.1.3",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/teilorbarcelos/mage-react-cam.git"
  },
  "bugs": {
    "url": "https://github.com/teilorbarcelos/mage-react-cam/issues"
  },
  "homepage": "https://teilorbarcelos.github.io/mage-react-cam-demo/",
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings=0",
      "bash -c 'npm run build'"
    ]
  }
}
